from typing import Literal

import numpy
from numpy.typing import NDArray

class Detector:
    def __init__(self, model_dir: str, threads: int = 4) -> None: ...
    @property
    def input_hw(self) -> tuple[int, int]: ...
    @property
    def names(self) -> dict[int, str]: ...
    @property
    def decode(self) -> Literal["yolo11", "yolo26"]: ...
    def detect(self, frame: NDArray[numpy.uint8], conf: float) -> NDArray[numpy.float32]: ...
    def detect_with_timings(
        self, frame: NDArray[numpy.uint8], conf: float
    ) -> tuple[NDArray[numpy.float32], dict[str, float]]: ...

def _letterbox(
    frame: NDArray[numpy.uint8], height_px: int, width_px: int
) -> NDArray[numpy.uint8]: ...
